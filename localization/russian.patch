+# sc-offline 0.7.3 RU. Формат: ключ = значение. Строки с # — комментарии.
+# Укажите отдельную копию игры. Без game лаунчер ищет установку автоматически.
+# game = D:\StarCitizen\LocalClient
+channel = LIVE
+
+# PU_All загружает системы для перемещения в Pyro и Nyx. Старые DLL знают только PU.
+boot_map = PU_All
+# Пустое start — обычное место появления игры.
+# start = Daymar сажает в start_ship над Daymar примерно через 10 секунд.
+# start_ship без start = Daymar не меняет появление.
+start_ship = DRAK_Cutlass_Black
+start =
+
+# Сторонние плагины из data\plugins\<id>. Они выполняют код внутри игры.
+plugins = off
+# Сессия LAN/VPN начинается только после «Создать сессию» / «Подключиться».
+# Общей физики, миссий и инвентаря между игроками нет.
+multiplayer = on
+# Дополнительные диапазоны IPv4 для VPN: до 8, /8 или уже, через запятую.
+# Например Tailscale: 100.64.0.0/10. Пусто — только локальная сеть.
+multiplayer_allow =
+
+# Терминалы кораблей, личные ангары, лифт и обращения к диспетчеру.
+# Хранение кораблей действует в пределах сессии.
+asop = on
+# ships — data\ships.txt; game — список игры, который может быть пуст офлайн.
+asop_fleet_list = ships
+
+# Системные изменения на время игры; восстанавливаются после выхода.
+# Брандмауэр блокирует игру, RSI Launcher и CrashHandler. LAN доступен для сессии.
+block_network = on
+# Строка hosts препятствует повторной загрузке EAC лаунчером RSI.
+eac_hosts = on
+# Общий EasyAntiCheat_EOS.exe переименовывается в .bak на время игры.
+eac_rename = on
+
+# Сохранять журналы. ask — спрашивать перед удалением, off — не удалять.
+clean_logs = off
+# Предлагать локальный обезличенный отчёт о сбое; автоматической отправки нет.
+crash_reports = on
+# Показывать статус игры в Discord (для русского пакета выключено).
+discord_presence = off
+
+# Выключено, чтобы оригинальное обновление не заменило русскую сборку.
+# Команда update проверяет оригинальные релизы и может убрать перевод.
+check_updates = off
+update_channel = stable
+
+# Exploration 1: продолжение последней сессии и автосохранение раз в минуту.
+resume = off
+autosave = on
