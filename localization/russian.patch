+    if(!registered)return;
+    auto wnd=CreateWindowExW(WS_EX_DLGMODALFRAME,L"sc-offline-flight-profile",L"Профиль свободного полёта",WS_CAPTION|WS_SYSMENU|WS_VISIBLE,CW_USEDEFAULT,CW_USEDEFAULT,590,390,parent,nullptr,GetModuleHandleW(nullptr),nullptr);
+    if(!wnd)return;EnableWindow(parent,FALSE);MSG m;
+    while(IsWindow(wnd)&&GetMessageW(&m,nullptr,0,0)>0){if(!IsDialogMessageW(wnd,&m)){TranslateMessage(&m);DispatchMessageW(&m);}}
+    EnableWindow(parent,TRUE);SetForegroundWindow(parent);
