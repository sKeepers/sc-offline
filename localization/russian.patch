+    Out("PASS stale log and capability report excluded\n");
+    const auto ini=fixture+L"\\test.ini";
+    if(!WriteAll(ini,"# keep comment\nresume = on\nautosave = off\nstart_ship = DRAK_Cutlass_Black\n") || !SetIniValue(ini,"start","Daymar"))return 1;
+    Config cfg;ReadConfig(ini,cfg);std::string contents;ReadAll(ini,contents);
+    if(!cfg.resume || cfg.autosave || cfg.start!=L"Daymar" || contents.find("# keep comment")==std::string::npos)return 1;
+    Out("PASS flight configuration parsed; profile update preserves existing keys and comments\n");return 0;
+}
+
+enum { pfStart=1,pfShip,pfSave,pfCancel,pfAutosave };
+static LRESULT CALLBACK FlightProfileProc(HWND wnd,UINT msg,WPARAM wp,LPARAM lp) {
+    if(msg==WM_CREATE) {
+        auto control=[&](const wchar_t* cls,const wchar_t* text,DWORD style,int id,int x,int y,int w,int h){
+            auto c=CreateWindowExW(0,cls,text,WS_CHILD|WS_VISIBLE|style,x,y,w,h,wnd,(HMENU)(INT_PTR)id,nullptr,nullptr);
+            SendMessageW(c,WM_SETFONT,(WPARAM)g_gui.font,TRUE);return c;
+        };
+        Config cfg;FILE* old=g_log;g_log=nullptr;ReadConfig(g_gui.here+L"\\sc-offline.ini",cfg);g_log=old;
+        control(L"STATIC",L"Начало полёта",0,0,18,18,540,24);
+        auto start=control(L"COMBOBOX",L"",CBS_DROPDOWNLIST|WS_TABSTOP|WS_VSCROLL,pfStart,18,46,540,150);
+        for(auto s:{L"Обычное место появления",L"Над Daymar на выбранном корабле",L"Продолжить сохранённую сессию"})SendMessageW(start,CB_ADDSTRING,0,(LPARAM)s);
+        SendMessageW(start,CB_SETCURSEL,cfg.resume?2:!_wcsicmp(cfg.start.c_str(),L"Daymar")?1:0,0);
+        control(L"STATIC",L"Корабль для старта над Daymar",0,0,18,88,540,24);
+        auto ship=control(L"COMBOBOX",L"",CBS_DROPDOWN|WS_TABSTOP|WS_VSCROLL,pfShip,18,116,540,320);
+        std::string text;if(ReadAll(g_gui.here+L"\\data\\ships.txt",text)) {
+            size_t from=0;while(from<text.size()){auto end=text.find('\n',from);auto row=text.substr(from,end==std::string::npos?std::string::npos:end-from);
+                if(!row.empty() && row.back()=='\r')row.pop_back();if(!row.empty()&&row[0]!='#'){std::wstring w(row.begin(),row.end());SendMessageW(ship,CB_ADDSTRING,0,(LPARAM)w.c_str());}
+                if(end==std::string::npos)break;from=end+1;
+            }
+        }
+        SetWindowTextW(ship,cfg.startShip.c_str());
+        auto check=control(L"BUTTON",L"Автосохранение раз в минуту",BS_AUTOCHECKBOX|WS_TABSTOP,pfAutosave,18,166,540,26);
+        SendMessageW(check,BM_SETCHECK,cfg.autosave?BST_CHECKED:BST_UNCHECKED,0);
+        control(L"STATIC",L"Продолжение использует сохранённое место и класс корабля.\nГруз, повреждения и ориентация корабля не восстанавливаются.\nИзбранное и маршруты: M → «Полёт и задания».",0,0,18,205,540,80);
+        control(L"BUTTON",L"Сохранить профиль",BS_DEFPUSHBUTTON|WS_TABSTOP,pfSave,18,304,240,34);
+        control(L"BUTTON",L"Отмена",BS_PUSHBUTTON|WS_TABSTOP,pfCancel,278,304,180,34);
+        return 0;
+    }
+    if(msg==WM_COMMAND && LOWORD(wp)==pfSave) {
+        wchar_t ship[256];GetWindowTextW(GetDlgItem(wnd,pfShip),ship,256);
+        const int choice=(int)SendMessageW(GetDlgItem(wnd,pfStart),CB_GETCURSEL,0,0);
+        std::string cls=Narrow(ship);
+        if(cls.empty() || cls.size()>63 || cls.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")!=std::string::npos){MessageBoxW(wnd,L"Выберите класс корабля из списка: только латинские буквы, цифры, _ и -.",L"Профиль полёта",MB_OK);return 0;}
+        const wstring ini=g_gui.here+L"\\sc-offline.ini";
+        // Snapshot first: roll back all settings if any write fails.
+        std::string original;const bool have=ReadAll(ini,original);
+        const bool ok=SetIniValue(ini,"start_ship",cls.c_str()) && SetIniValue(ini,"start",choice==1?"Daymar":"") &&
+            SetIniValue(ini,"resume",choice==2?"on":"off") && SetIniValue(ini,"autosave",SendMessageW(GetDlgItem(wnd,pfAutosave),BM_GETCHECK,0,0)==BST_CHECKED?"on":"off");
+        if(!ok){if(have)WriteAll(ini,original);MessageBoxW(wnd,L"Не удалось сохранить профиль; проверьте доступ к sc-offline.ini.",L"Профиль полёта",MB_OK);return 0;}
+        AppendOutput(L"\nПрофиль полёта сохранён. Нажмите «Играть» для запуска.\n");DestroyWindow(wnd);return 0;
+    }
+    if((msg==WM_COMMAND && LOWORD(wp)==pfCancel)||msg==WM_CLOSE){DestroyWindow(wnd);return 0;}
