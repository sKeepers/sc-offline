# Line endings by file type, so a clone on any OS builds and runs.
* text=auto
*.sh        text eol=lf
*.ini       text eol=crlf
*.bat       text eol=crlf
*.dll       binary
*.exe       binary
*.webp      binary
*.png       binary
*.jpg       binary

# Exact ImGui source digests require LF on Windows as well.
src/third_party/imgui/* text eol=lf
